{
  "name": "fpn-editor-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dev-only editor for `fpn serve`. Built into ../web/editor (committed), so Go-only contributors never need Node.",
  "scripts": {
    "dev": "node scripts/copy-codicons.mjs && vite",
    "build": "node scripts/copy-codicons.mjs && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@vscode-elements/elements": "2.5.1",
    "@vscode/codicons": "0.0.45",
    "monaco-editor": "0.57.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
